<section class="hero-section relative w-full overflow-hidden">
  {%- if section.settings.background_image != blank -%}
    {{ section.settings.background_image | image_url: width: 1920 | image_tag: class: 'hero-bg-img absolute inset-0 h-full w-full object-cover object-center', aria_hidden: true }}
  {%- else -%}
    <img src="https://images.pexels.com/photos/1001682/pexels-photo-1001682.jpeg?auto=compress&cs=tinysrgb&w=1920" alt="" class="hero-bg-img absolute inset-0 h-full w-full object-cover object-center" aria-hidden="true" width="1920" height="1080">
  {%- endif -%}
  <div class="hero-overlay absolute inset-0" aria-hidden="true"></div>
  <div class="hero-light-ray absolute inset-0" aria-hidden="true"></div>
  <div class="hero-particles pointer-events-none absolute inset-0 z-[1]" aria-hidden="true">
    <span></span><span></span><span></span><span></span><span></span><span></span>
  </div>

  <div class="relative z-10 mx-auto grid max-w-content grid-cols-1 items-center gap-14 px-6 lg:grid-cols-2 lg:px-12 lg:py-8">
    <div class="py-16 lg:py-24 lg:pr-8">
      {%- if section.settings.label != blank -%}
        <p class="section-label mb-5">{{ section.settings.label }}</p>
      {%- endif -%}
      <h1 class="mb-6 text-[2.35rem] font-extrabold leading-[1.08] tracking-tight sm:text-5xl lg:text-[3.5rem]">
        {{ section.settings.heading }} <span class="heading-accent">{{ section.settings.heading_accent }}</span>
      </h1>
      {%- if section.settings.text != blank -%}
        <p class="mb-9 max-w-md text-[15px] leading-relaxed text-[#8fa3b8]">{{ section.settings.text }}</p>
      {%- endif -%}
      <div class="mb-12 flex flex-wrap gap-4">
        {%- if section.settings.button_1_label != blank -%}
          <a href="{{ section.settings.button_1_link }}" class="btn-lime-ref inline-flex items-center gap-2 px-7 py-3.5 text-[11px] font-bold tracking-[0.12em]">{{ section.settings.button_1_label }} <span>→</span></a>
        {%- endif -%}
        {%- if section.settings.button_2_label != blank -%}
          <a href="{{ section.settings.button_2_link }}" class="btn-ghost-ref inline-flex items-center gap-2 px-7 py-3.5 text-[11px] font-bold tracking-[0.12em]">{{ section.settings.button_2_label }} <span>→</span></a>
        {%- endif -%}
      </div>
      <ul class="trust-grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'trust_item' -%}
            <li class="flex items-center gap-3" {{ block.shopify_attributes }}>
              <span class="trust-hex">
                {%- if block.settings.icon_svg != blank -%}{{ block.settings.icon_svg }}{%- else -%}
                  <svg fill="currentColor" viewBox="0 0 20 20"><path d="M10 2l6 3v5c0 4-3 7.5-6 8.5C7 17.5 4 14 4 10V5z"/></svg>
                {%- endif -%}
              </span>
              <span class="text-[10px] font-bold leading-tight tracking-wide text-[#d2ff34]">{{ block.settings.text | newline_to_br }}</span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
    <div class="hero-visual-wrap pb-12 lg:pb-0">
      {%- if section.settings.side_image != blank -%}
        {{ section.settings.side_image | image_url: width: 900 | image_tag: class: 'hero-visual-img', loading: 'eager', alt: section.settings.side_image.alt }}
      {%- else -%}
        <img src="https://images.unsplash.com/photo-1559827260-dc66d52bef19?w=800&q=80" alt="Live phytoplankton in ocean water" class="hero-visual-img" loading="eager" width="800" height="600">
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PF Hero",
  "tag": "section",
  "class": "pf-section",
  "settings": [
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "image_picker", "id": "side_image", "label": "Side image" },
    { "type": "text", "id": "label", "label": "Label", "default": "LIVE NUTRITION. REAL RESULTS." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Feed Your Reef Like" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent", "default": "Nature Intended." },
    { "type": "textarea", "id": "text", "label": "Description", "default": "Premium live phytoplankton and copepod cultures engineered for explosive coral growth, vibrant coloration, and thriving marine ecosystems." },
    { "type": "text", "id": "button_1_label", "label": "Button 1", "default": "SHOP PHYTOPLANKTON" },
    { "type": "url", "id": "button_1_link", "label": "Button 1 link" },
    { "type": "text", "id": "button_2_label", "label": "Button 2", "default": "SHOP COPEPODS" },
    { "type": "url", "id": "button_2_link", "label": "Button 2 link" }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust badge",
      "settings": [
        { "type": "html", "id": "icon_svg", "label": "Icon SVG (optional)" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "LIVE ARRIVAL\nGUARANTEE" }
      ]
    }
  ],
  "presets": [{ "name": "PF Hero", "blocks": [
    { "type": "trust_item", "settings": { "text": "LIVE ARRIVAL\nGUARANTEE" } },
    { "type": "trust_item", "settings": { "text": "FRESH\nHARVESTED" } },
    { "type": "trust_item", "settings": { "text": "LAB\nCULTURED" } },
    { "type": "trust_item", "settings": { "text": "REEF\nTESTED" } }
  ]}]
}
{% endschema %}
