<section class="w-full bg-[#07111f] border border-[#162234] overflow-hidden">
  <div class="mx-auto flex max-w-[1400px] flex-col lg:flex-row items-center justify-between px-6 py-5 lg:px-10">
    <div class="flex flex-col lg:flex-row lg:items-center gap-8 lg:gap-14">
      <div class="max-w-[340px]">
        <h2 class="text-[34px] leading-[1.05] font-extrabold text-white tracking-[-0.03em]">
          {{ section.settings.heading }} <span class="text-[#d2ff34]">{{ section.settings.heading_accent }}</span>
        </h2>
        {%- if section.settings.subtext != blank -%}<p class="mt-2 text-[13px] text-[#8fa3b8]">{{ section.settings.subtext }}</p>{%- endif -%}
      </div>
      <div class="flex flex-wrap items-center gap-x-10 gap-y-5">
        {%- for block in section.blocks -%}
          <div class="flex flex-col items-center text-center" {{ block.shopify_attributes }}>
            <div class="mb-2 flex h-11 w-11 items-center justify-center rounded-full border border-[#2c3b4d] text-[#d2ff34]">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M12 3v18"/></svg>
            </div>
            <p class="text-[12px] font-semibold leading-none text-[#d2ff34]">{{ block.settings.title }}</p>
            <p class="mt-1 text-[10px] text-[#75879c]">{{ block.settings.subtitle }}</p>
          </div>
        {%- endfor -%}
      </div>
    </div>
    <div class="mt-8 flex flex-col items-center lg:mt-0 lg:flex-row lg:items-center lg:gap-5">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 420 | image_tag: class: 'mb-5 w-[170px] object-contain lg:mb-0 lg:w-[210px]', alt: 'Subscription product' }}
      {%- endif -%}
      <div class="flex flex-col gap-3">
        {%- if section.settings.button_1_label != blank -%}
          <a href="{{ section.settings.button_1_link }}" class="flex h-[42px] min-w-[210px] items-center justify-center bg-[#d2ff34] px-6 text-[10px] font-extrabold tracking-[0.14em] text-black transition hover:bg-[#ddff69]">{{ section.settings.button_1_label }}</a>
        {%- endif -%}
        {%- if section.settings.button_2_label != blank -%}
          <a href="{{ section.settings.button_2_link }}" class="flex h-[42px] min-w-[210px] items-center justify-center border border-[#334155] bg-transparent px-6 text-[10px] font-bold tracking-[0.14em] text-white transition hover:border-[#d2ff34] hover:text-[#d2ff34]">{{ section.settings.button_2_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PF Subscribe Banner",
  "tag": "section",
  "class": "pf-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Never Run Out of" },
    { "type": "text", "id": "heading_accent", "label": "Accent", "default": "Reef Nutrition." },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "Save money. Ensure consistency." },
    { "type": "image_picker", "id": "image", "label": "Product image" },
    { "type": "text", "id": "button_1_label", "label": "Primary button", "default": "START YOUR SUBSCRIPTION" },
    { "type": "url", "id": "button_1_link", "label": "Primary link" },
    { "type": "text", "id": "button_2_label", "label": "Secondary button", "default": "LEARN MORE →" },
    { "type": "url", "id": "button_2_link", "label": "Secondary link" }
  ],
  "blocks": [{
    "type": "perk",
    "name": "Perk",
    "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Save 10%+" },
      { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Every Order" }
    ]
  }],
  "presets": [{ "name": "PF Subscribe Banner" }]
}
{% endschema %}
