<section class="about-hero w-full">
  <div class="about-hero-inner mx-auto grid max-w-content grid-cols-1 items-center gap-12 px-6 lg:grid-cols-2 lg:gap-16 lg:px-12">
    <div>
      {%- if section.settings.label != blank -%}<p class="section-label mb-5">{{ section.settings.label }}</p>{%- endif -%}
      <h1>{{ section.settings.heading }}<br><span class="heading-accent">{{ section.settings.heading_accent }}</span></h1>
      {%- if section.settings.text != blank -%}<p class="mb-10 max-w-lg text-[15px] leading-relaxed pf-muted">{{ section.settings.text }}</p>{%- endif -%}
      <div class="flex flex-wrap gap-4">
        {%- if section.settings.button_1_label != blank -%}<a href="{{ section.settings.button_1_link }}" class="btn-lime-solid">{{ section.settings.button_1_label }}</a>{%- endif -%}
        {%- if section.settings.button_2_label != blank -%}<a href="{{ section.settings.button_2_link }}" class="btn-ghost-ref inline-flex items-center gap-2 border px-7 py-3.5 text-[11px] font-bold tracking-[0.12em]">{{ section.settings.button_2_label }} <span>→</span></a>{%- endif -%}
      </div>
    </div>
    {%- if section.settings.image != blank -%}
      <div class="about-hero-visual">{{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'eager', alt: section.settings.image.alt }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "PF About Hero",
  "tag": "section",
  "class": "pf-section",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "ABOUT US" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Passion. Science. Sustainability." },
    { "type": "text", "id": "heading_accent", "label": "Accent", "default": "That's PhytoFreak." },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "button_1_label", "label": "Button 1", "default": "OUR STORY" },
    { "type": "url", "id": "button_1_link", "label": "Button 1 link" },
    { "type": "text", "id": "button_2_label", "label": "Button 2", "default": "OUR CULTURES" },
    { "type": "url", "id": "button_2_link", "label": "Button 2 link" }
  ],
  "presets": [{ "name": "PF About Hero" }]
}
{% endschema %}
