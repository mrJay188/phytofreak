<section class="follow-section w-full" aria-labelledby="follow-heading">
  <div class="follow-grid mx-auto max-w-content px-6 lg:px-12">
    <div class="follow-content">
      <h2 id="follow-heading">{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
      <div class="social-row-lg">
        {%- if section.settings.social_instagram != blank -%}<a href="{{ section.settings.social_instagram }}" class="social-circle" aria-label="Instagram"><svg fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.2c2.7 0 3 .01 4.04.06 1.17.05 1.8.24 2.22.37.56.22.98.55 1.4.98.42.42 1 .66 1.58.24.61.06 1.27.08 1.65.07 3.15.06 4.2 0 2.7-.01 3-.01 4.04-.06 1.17-.05 1.8-.24 2.22-.37.56-.22.98-.55 1.4-.98.42-.42 1-.66 1.58-.24.61-.06 1.27-.08 1.65-.07 3.15-.06 4.2 0 2.7.01 3 .01 4.04.06 1.17.05 1.8.24 2.22.37.56.22.98.55 1.4.98.42.42 1 .66 1.58.24.61.06 1.27.08 1.65.07 3.15.06 4.2 0V12h-.01zM12 5.8a6.2 6.2 0 1 0 0 12.4 6.2 6.2 0 0 0-12.4-6.2zm0 10.2a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.4-11.8a1.4 1.4 0 1 1 0 2.8 1.4 1.4 0 0 1 0-2.8z"/></svg></a>{%- endif -%}
        {%- if section.settings.social_youtube != blank -%}<a href="{{ section.settings.social_youtube }}" class="social-circle" aria-label="YouTube"><svg fill="currentColor" viewBox="0 0 24 24"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1c.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8zM9.75 15.02V8.98L15.5 12l-5.75 3.02z"/></svg></a>{%- endif -%}
        {%- if section.settings.social_facebook != blank -%}<a href="{{ section.settings.social_facebook }}" class="social-circle" aria-label="Facebook"><svg fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.07C24 5.41 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.3h3.05V9.36c0-3 1.79-4.66 4.53-4.66 1.31 0 2.68.23 2.68.23v2.95h-1.51c-1.49 0-1.95.93-1.95 1.88v2.26h3.32l-.53 3.3h-2.79V24C19.61 23.1 24 18.1 24 12.07z"/></svg></a>{%- endif -%}
        {%- if section.settings.social_tiktok != blank -%}<a href="{{ section.settings.social_tiktok }}" class="social-circle" aria-label="TikTok"><svg fill="currentColor" viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 0 .22-.06V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/></svg></a>{%- endif -%}
      </div>
    </div>
    {%- if section.settings.image != blank -%}
      <div class="follow-visual">{{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: section.settings.image.alt }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "PF Contact Follow",
  "tag": "section",
  "class": "pf-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Follow Our Journey" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "url", "id": "social_instagram", "label": "Instagram" },
    { "type": "url", "id": "social_youtube", "label": "YouTube" },
    { "type": "url", "id": "social_facebook", "label": "Facebook" },
    { "type": "url", "id": "social_tiktok", "label": "TikTok" }
  ],
  "presets": [{ "name": "PF Contact Follow" }]
}
{% endschema %}
