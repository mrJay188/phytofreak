{%- liquid
  assign product_collection = section.settings.collection
  if product_collection == blank
    assign product_collection = collections.all
  endif
  assign has_products = false
  if product_collection.products_count > 0
    assign has_products = true
  endif
-%}
<section class="section-pad w-full bg-[#050a14]">
  <div class="mx-auto max-w-content px-6 lg:px-12">
    <div class="mb-12 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        {%- if section.settings.label != blank -%}<p class="section-label mb-2">{{ section.settings.label }}</p>{%- endif -%}
        <h2 class="text-3xl font-bold lg:text-[2.4rem]">{{ section.settings.heading }}</h2>
      </div>
      {%- if product_collection != blank -%}
        <a href="{{ product_collection.url }}" class="text-[11px] font-bold tracking-[0.14em] text-lime hover:text-lime-light">{{ section.settings.view_all_label }} →</a>
      {%- endif -%}
    </div>

    {%- if has_products -%}
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 xl:grid-cols-4">
        {%- for product in product_collection.products limit: section.settings.products_to_show -%}
          {%- assign badge_text = product.metafields.custom.badge | default: '' -%}
          {%- if badge_text == blank -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'product' and block.settings.product != blank and block.settings.product.id == product.id and block.settings.badge != blank -%}
                {%- assign badge_text = block.settings.badge -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
          {% render 'pf-product-card', product: product, badge: badge_text %}
        {%- endfor -%}
      </div>
    {%- else -%}
      {%- assign manual_count = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'product' and block.settings.product != blank -%}
          {%- assign manual_count = manual_count | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if manual_count > 0 -%}
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 xl:grid-cols-4">
          {%- for block in section.blocks -%}
            {%- if block.type == 'product' and block.settings.product != blank -%}
              {% render 'pf-product-card', product: block.settings.product, badge: block.settings.badge %}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <p class="text-center text-sm text-slate-400">Add products in Shopify Admin — they appear here automatically from your catalog.</p>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "PF Featured Products",
  "tag": "section",
  "class": "pf-section",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "PREMIUM LIVE CULTURES" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our Most Popular Products" },
    { "type": "collection", "id": "collection", "label": "Collection (leave empty to use all products)" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 12, "step": 1, "label": "Products to show", "default": 4 },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "VIEW ALL PRODUCTS" }
  ],
  "blocks": [
    { "type": "product", "name": "Product (manual)", "settings": [
      { "type": "product", "id": "product", "label": "Product" },
      { "type": "textarea", "id": "badge", "label": "Badge text" }
    ]}
  ],
  "presets": [{ "name": "PF Featured Products" }]
}
{% endschema %}
