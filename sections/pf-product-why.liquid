<section class="pd-why w-full">
  <div class="mx-auto max-w-content px-6 lg:px-12">
    <div class="pd-split">
      {%- if section.settings.image != blank -%}
        <div class="pd-split-img">
          {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: section.settings.heading }}
        </div>
      {%- endif -%}
      <div>
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<div class="rte pf-muted">{{ section.settings.text }}</div>{%- endif -%}
        <ul class="pd-check-list">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              <span class="pd-check"><svg fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 12 12"><path d="M2 6l3 3 5-6"/></svg></span>
              {{ block.settings.text }}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PF Product Why",
  "tag": "section",
  "class": "pf-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why Choose PhytoFreak?" },
    { "type": "richtext", "id": "text", "label": "Text" }
  ],
  "blocks": [{ "type": "point", "name": "Point", "settings": [{ "type": "text", "id": "text", "label": "Text" }] }],
  "presets": [{ "name": "PF Product Why" }]
}
{% endschema %}
