{%- if section.settings.show_section -%}
{%- liquid
  assign bundle_products = '' | split: ''
  assign bundle_count = 0
  for block in section.blocks
    if block.type == 'product' and block.settings.product != blank
      assign bundle_count = bundle_count | plus: 1
    endif
  endfor
-%}
<section class="pd-bundle w-full">
  <div class="mx-auto max-w-content px-6 lg:px-12">
    <h2>{{ section.settings.heading }}</h2>
    <div class="pd-bundle-row">
      {%- assign bundle_total = 0 -%}
      {%- assign shown = 0 -%}

      {%- if bundle_count > 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.product != blank -%}
            {%- assign bp = block.settings.product -%}
            {%- if bp.id != product.id -%}
              {%- assign bundle_total = bundle_total | plus: bp.selected_or_first_available_variant.price -%}
              {%- assign shown = shown | plus: 1 -%}
              {%- unless shown == 1 -%}<span class="pd-bundle-op" aria-hidden="true">+</span>{%- endunless -%}
              <article class="pd-bundle-card" {{ block.shopify_attributes }}>
                {%- if bp.featured_image -%}
                  {{ bp.featured_image | image_url: width: 300 | image_tag: alt: bp.title }}
                {%- endif -%}
                <h3>{{ bp.title }}</h3>
                <p>{{ bp.selected_or_first_available_variant.title }}</p>
                <p class="price">{{ bp.price | money }}</p>
              </article>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      {%- elsif product.collections.first != blank -%}
        {%- for bp in product.collections.first.products limit: 4 -%}
          {%- if bp.id != product.id -%}
            {%- assign bundle_total = bundle_total | plus: bp.selected_or_first_available_variant.price -%}
            {%- assign shown = shown | plus: 1 -%}
            {%- if shown > 3 -%}{%- break -%}{%- endif -%}
            {%- unless shown == 1 -%}<span class="pd-bundle-op" aria-hidden="true">+</span>{%- endunless -%}
            <article class="pd-bundle-card">
              {%- if bp.featured_image -%}
                {{ bp.featured_image | image_url: width: 300 | image_tag: alt: bp.title }}
              {%- endif -%}
              <h3>{{ bp.title }}</h3>
              <p>{{ bp.selected_or_first_available_variant.title }}</p>
              <p class="price">{{ bp.price | money }}</p>
            </article>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}

      {%- if shown > 0 -%}
        {%- assign discount = section.settings.discount_percent | times: 1.0 | divided_by: 100.0 -%}
        {%- assign discount_amount = bundle_total | times: discount -%}
        <span class="pd-bundle-op" aria-hidden="true">=</span>
        <div class="pd-bundle-total">
          <p class="label">Total Price:</p>
          <p class="total">{{ bundle_total | minus: discount_amount | money }}</p>
          <p class="was">{{ bundle_total | money }}</p>
          <p class="save">You Save {{ section.settings.discount_percent }}%</p>
          <a href="{{ routes.cart_url }}" class="btn-lime-solid">ADD BUNDLE TO CART</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "PF Product Bundle",
  "tag": "section",
  "class": "pf-section",
  "settings": [
    { "type": "checkbox", "id": "show_section", "label": "Show section", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Bought Together" },
    { "type": "range", "id": "discount_percent", "min": 0, "max": 30, "step": 1, "label": "Discount %", "default": 10 }
  ],
  "blocks": [{ "type": "product", "name": "Product", "settings": [{ "type": "product", "id": "product", "label": "Product" }] }],
  "presets": [{ "name": "PF Product Bundle" }]
}
{% endschema %}
