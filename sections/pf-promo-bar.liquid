<div class="promo-bar-ref w-full">
  <div class="promo-grid mx-auto max-w-content px-6 py-4 lg:px-12">
    <p class="text-[11px] font-semibold tracking-wide text-cyan lg:text-left">
      {{ section.settings.timer_label }}
      <span class="timer-block">
        <span class="timer-unit"><span class="num" id="t-h">{{ section.settings.timer_hours }}</span><span class="lbl">HRS</span></span>
        <span class="timer-unit"><span class="num" id="t-m">{{ section.settings.timer_minutes }}</span><span class="lbl">MIN</span></span>
        <span class="timer-unit"><span class="num" id="t-s">{{ section.settings.timer_seconds }}</span><span class="lbl">SEC</span></span>
      </span>
    </p>
    <p class="text-[11px] font-semibold tracking-wide text-slate-300">{{ section.settings.center_text }}</p>
    <p class="text-[11px] font-semibold tracking-wide text-slate-400">
      <span class="text-lime tracking-widest">★★★★★</span> {{ section.settings.rating_text }}
    </p>
  </div>
</div>

{% schema %}
{
  "name": "PF Promo Bar",
  "tag": "section",
  "class": "pf-section",
  "settings": [
    { "type": "text", "id": "timer_label", "label": "Timer label", "default": "NEXT FRESH HARVEST SHIPS IN" },
    { "type": "text", "id": "timer_hours", "label": "Hours", "default": "14" },
    { "type": "text", "id": "timer_minutes", "label": "Minutes", "default": "10" },
    { "type": "text", "id": "timer_seconds", "label": "Seconds", "default": "17" },
    { "type": "text", "id": "center_text", "label": "Center text", "default": "ORDER NOW FOR GUARANTEED SHIPMENT!" },
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "4.9/5 FROM 1,200+ REEFERS" }
  ],
  "presets": [{ "name": "PF Promo Bar" }]
}
{% endschema %}
