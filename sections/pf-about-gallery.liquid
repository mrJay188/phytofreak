<section class="about-gallery w-full">
  <h2>{{ section.settings.heading }}</h2>
  <div class="about-gallery-row">
    {%- for block in section.blocks -%}
      {%- if block.settings.image != blank -%}
        {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.alt }}
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "PF About Gallery",
  "tag": "section",
  "class": "pf-section",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Trusted By Reef Keepers Worldwide" }],
  "blocks": [{
    "type": "image",
    "name": "Image",
    "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "alt", "label": "Alt text" }
    ]
  }],
  "presets": [{ "name": "PF About Gallery" }]
}
{% endschema %}
