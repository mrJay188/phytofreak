<section class="section-pad w-full bg-[#050a14]">
  <div class="mx-auto max-w-content px-6 lg:px-12">
    <div class="mb-12">
      {%- if section.settings.label != blank -%}<p class="section-label mb-2">{{ section.settings.label }}</p>{%- endif -%}
      <h1 class="text-3xl font-bold lg:text-[2.4rem]">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <p class="mt-4 max-w-2xl text-[15px] leading-relaxed pf-muted">{{ collection.description }}</p>
      {%- endif -%}
    </div>
    {%- paginate collection.products by section.settings.products_per_page -%}
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 xl:grid-cols-4">
        {%- for product in collection.products -%}
          {% render 'pf-product-card', product: product %}
        {%- else -%}
          <p class="pf-muted">No products in this collection yet.</p>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <nav class="mt-12 flex justify-center gap-4 text-sm pf-muted" aria-label="Pagination">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="hover:text-lime">← Previous</a>{%- endif -%}
          <span>Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="hover:text-lime">Next →</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "PF Collection",
  "tag": "section",
  "class": "pf-section",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "SHOP" },
    { "type": "range", "id": "products_per_page", "min": 8, "max": 36, "step": 4, "label": "Products per page", "default": 16 }
  ]
}
{% endschema %}
