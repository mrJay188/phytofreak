<footer class="w-full border-t border-white/[0.08] bg-[#03060c]">
  <div class="mx-auto grid max-w-content grid-cols-1 gap-12 px-6 py-16 sm:grid-cols-2 lg:grid-cols-5 lg:px-12">
    <div>
      <a href="{{ routes.root_url }}" class="mb-5 flex items-center gap-3">
        {%- if section.settings.logo != blank -%}
          {{ section.settings.logo | image_url: width: 80 | image_tag: class: 'h-9 w-9 object-contain', alt: shop.name }}
        {%- else -%}
          <span class="logo-mark h-9 w-9"></span>
        {%- endif -%}
        <span class="text-lg font-bold">{{ section.settings.logo_text | default: 'Phyto' }}<span class="pf-lime">{{ section.settings.logo_accent | default: 'Freak' }}</span></span>
      </a>
      <p class="mb-8 max-w-xs text-sm leading-relaxed pf-muted">{{ section.settings.description }}</p>
      {%- if section.settings.show_social -%}
        <div class="flex gap-3">
          {%- if section.settings.social_instagram != blank -%}
            <a href="{{ section.settings.social_instagram }}" class="flex h-10 w-10 items-center justify-center rounded-full border border-[#2c3b4d] pf-muted transition hover:border-cyan hover:text-cyan" aria-label="Instagram">IG</a>
          {%- endif -%}
          {%- if section.settings.social_youtube != blank -%}
            <a href="{{ section.settings.social_youtube }}" class="flex h-10 w-10 items-center justify-center rounded-full border border-[#2c3b4d] pf-muted transition hover:border-cyan hover:text-cyan" aria-label="YouTube">YT</a>
          {%- endif -%}
          {%- if section.settings.social_tiktok != blank -%}
            <a href="{{ section.settings.social_tiktok }}" class="flex h-10 w-10 items-center justify-center rounded-full border border-[#2c3b4d] pf-muted transition hover:border-cyan hover:text-cyan" aria-label="TikTok">TK</a>
          {%- endif -%}
          {%- if section.settings.social_facebook != blank -%}
            <a href="{{ section.settings.social_facebook }}" class="flex h-10 w-10 items-center justify-center rounded-full border border-[#2c3b4d] pf-muted transition hover:border-cyan hover:text-cyan" aria-label="Facebook">FB</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'menu' -%}
          <div {{ block.shopify_attributes }}>
            <h4 class="mb-5 text-[11px] font-bold tracking-[0.15em] text-white">{{ block.settings.heading | upcase }}</h4>
            <ul class="space-y-2.5 text-sm pf-muted">
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}" class="transition hover:text-white{% if link.active %} pf-lime{% endif %}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- when 'newsletter' -%}
          <div {{ block.shopify_attributes }}>
            <h4 class="mb-5 text-[11px] font-bold tracking-[0.15em] text-white">{{ block.settings.heading | upcase }}</h4>
            <p class="mb-5 text-sm pf-muted">{{ block.settings.text }}</p>
            {% form 'customer', class: 'flex overflow-hidden rounded border border-white/[0.08]' %}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <input type="email" name="contact[email]" placeholder="{{ block.settings.placeholder }}" class="min-w-0 flex-1 bg-[#0c1528] px-4 py-3 text-sm text-white placeholder-slate-600 outline-none focus:ring-1 focus:ring-lime/30" aria-label="Email" required>
              <button type="submit" class="bg-lime px-5 text-[#050a14] transition hover:bg-lime-light" aria-label="Subscribe">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </button>
            {% endform %}
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>

  <div class="border-t border-white/[0.06]">
    <div class="mx-auto flex max-w-content flex-col items-center justify-between gap-5 px-6 py-7 text-xs pf-muted md:flex-row lg:px-12">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.copyright_text }}</p>
      <ul class="flex flex-wrap justify-center gap-8">
        {%- for block in section.blocks -%}
          {%- if block.type == 'trust_badge' -%}
            <li class="footer-trust-lime flex items-center gap-2" {{ block.shopify_attributes }}>
              <span class="trust-footer-icon"></span>{{ block.settings.text | upcase }}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
      {%- if section.settings.show_payment -%}
        <div class="payment-row">
          {%- for type in shop.enabled_payment_types -%}
            <span class="pay-badge">{{ type | replace: '_', ' ' | upcase }}</span>
          {%- else -%}
            <span class="pay-badge">VISA</span>
            <span class="pay-badge">MC</span>
            <span class="pay-badge">PayPal</span>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "PhytoFreak Footer",
  "class": "pf-footer-section",
  "max_blocks": 8,
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "text", "id": "logo_text", "label": "Logo text", "default": "Phyto" },
    { "type": "text", "id": "logo_accent", "label": "Logo accent", "default": "Freak" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Premium live phytoplankton and copepod cultures for a healthier, more vibrant reef." },
    { "type": "checkbox", "id": "show_social", "label": "Show social links", "default": true },
    { "type": "url", "id": "social_instagram", "label": "Instagram" },
    { "type": "url", "id": "social_youtube", "label": "YouTube" },
    { "type": "url", "id": "social_tiktok", "label": "TikTok" },
    { "type": "url", "id": "social_facebook", "label": "Facebook" },
    { "type": "text", "id": "copyright_text", "label": "Copyright suffix", "default": "All rights reserved." },
    { "type": "checkbox", "id": "show_payment", "label": "Show payment icons", "default": true }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Newsletter" },
        { "type": "text", "id": "text", "label": "Text", "default": "Get reef tips, restock alerts, and exclusive discounts." },
        { "type": "text", "id": "placeholder", "label": "Email placeholder", "default": "Enter your email" }
      ]
    },
    {
      "type": "trust_badge",
      "name": "Trust badge",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Live Arrival Guarantee" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "menu", "settings": { "heading": "Shop" } },
      { "type": "menu", "settings": { "heading": "Learn" } },
      { "type": "menu", "settings": { "heading": "Company" } },
      { "type": "newsletter" },
      { "type": "trust_badge", "settings": { "text": "Live Arrival Guarantee" } },
      { "type": "trust_badge", "settings": { "text": "Secure Checkout" } },
      { "type": "trust_badge", "settings": { "text": "Ships Fresh" } }
    ]
  }
}
{% endschema %}
